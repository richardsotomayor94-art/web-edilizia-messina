# =====================================================================
# Configurazione centrale (vedi src/config/site.ts e docs/DEPLOYMENT.md)
# NON committare valori reali. Su Vercel usare Environment Variables.
# =====================================================================

# --- Sito / brand / dominio ------------------------------------------
# URL canonico. Staging: https://<progetto>.vercel.app  — Produzione: https://dominio-definitivo.it
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=MessinaCasa360
NEXT_PUBLIC_SERVICE_AREA=Messina e provincia
# "true" SOLO sul dominio definitivo in produzione. Default: noindex ovunque.
NEXT_PUBLIC_SITE_INDEXABLE=false
# "true" solo nella copia dimostrativa pubblica: i moduli non inviano né salvano dati.
NEXT_PUBLIC_DEMO_MODE=false
# Solo in demo: "true" mostra recapiti sintetici (+39 000…, *.example) per rivedere il design. Fuori dalla demo non ha effetto.
# NEXT_PUBLIC_DEMO_CONTACTS=false

# --- Contatti pubblici (vuoti = non mostrati) -------------------------
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=          # solo cifre con prefisso, es. 393331234567
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# --- Dati legali del titolare (decision gate: pubblicare solo se confermati)
NEXT_PUBLIC_LEGAL_OWNER_NAME=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_PEC=

# --- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Segreto server per le RPC di ingestione. OBBLIGATORIO, minimo 32 caratteri:
# se manca o è più corto, /api/leads/ risponde 503 "not_configured".
# Nel DB va solo il suo SHA-256 (private.app_config.lead_ingest_secret_hash). Vedi README → "Variabili segrete".
LEAD_INGEST_SECRET=
# Sale per l'hash degli IP usato dal rate limit. Consigliato (se vuoto l'hash funziona ma senza sale).
IP_HASH_SALT=

# --- Notifiche (opzionali) --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_WEBHOOK_URL=                     # n8n / Make
LEAD_WEBHOOK_SECRET=                  # firma HMAC header x-signature

# --- Anti-spam (opzionale, gratuito) -----------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (opzionale, caricato solo dopo consenso) -----------------
NEXT_PUBLIC_GA4_ID=
